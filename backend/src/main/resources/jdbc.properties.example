# ===== 数据库连接配置（模板） =====
# 使用说明：复制本文件为 jdbc.properties，再填写真实密码。
# 真实 jdbc.properties 已被 .gitignore 排除，避免密码泄露。

# JDBC 驱动类：MySQL 8 官方驱动
jdbc.driver=com.mysql.cj.jdbc.Driver
# JDBC 连接地址：指向本地 MySQL 的 life_manager 库
# useUnicode/utf8 防中文乱码，serverTimezone 设亚洲时区，useSSL=false 关闭加密连接
jdbc.url=jdbc:mysql://localhost:3306/life_manager?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 数据库登录用户名
jdbc.username=root
# 数据库登录密码（明文，仅本地开发用；生产环境应改用加密或配置中心）
jdbc.password=你的数据库密码

# ===== Druid 连接池配置 =====
# 初始化时建立的最小连接数（启动预热）
druid.initialSize=5
# 保持的最小空闲连接数
druid.minIdle=5
# 最大活跃连接数
druid.maxActive=20
# 获取连接的最大等待时间（毫秒）
druid.maxWait=60000
# 后台清理线程运行间隔（毫秒）
druid.timeBetweenEvictionRunsMillis=60000
# 连接最少空闲多久才可被回收（毫秒）
druid.minEvictableIdleTimeMillis=300000
# 连接存活检测 SQL
druid.validationQuery=SELECT 1
# 空闲时执行存活检测
druid.testWhileIdle=true
# 借出连接时是否检测（false 减少开销，靠 testWhileIdle 兜底）
druid.testOnBorrow=false
druid.testOnReturn=false
